{
  "name": "agent-app-forge",
  "version": "0.1.1",
  "description": "Agent-agnostic software recreation, reverse engineering, and declarative full-stack application synthesis system with autonomous verification and MCP tooling.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forge": "bin/forge.js",
    "agent-app-forge": "bin/forge.js",
    "forge-mcp": "bin/mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "config",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/investigation', {recursive:true}); fs.copyFileSync('src/investigation/reaCatalog.json', 'dist/investigation/reaCatalog.json');\"",
    "test": "vitest run --fileParallelism=false",
    "mcp": "node bin/mcp.js",
    "forge": "node bin/forge.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "reverse-engineering",
    "software-recreation",
    "app-generation",
    "mcp",
    "model-context-protocol",
    "wasp",
    "rea",
    "sqlite",
    "self-repair"
  ],
  "author": "Agent App Forge Contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "playwright-core": "^1.64.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prasannakumar0718/skull.git"
  },
  "bugs": {
    "url": "https://github.com/prasannakumar0718/skull/issues"
  },
  "homepage": "https://github.com/prasannakumar0718/skull#readme"
}
